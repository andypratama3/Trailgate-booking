{
  "name": "trailgate",
  "version": "0.0.0",
  "private": true,
  "description": "TrailGate monorepo — booking jalur pendakian berbasis kuota.",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">= 22.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1"
  },
  "scripts": {
    "dev": "pnpm --filter @trailgate/web dev",
    "build": "pnpm --filter @trailgate/web build",
    "dev:pos": "pnpm --filter @trailgate/pos dev",
    "build:pos": "pnpm --filter @trailgate/pos build",
    "typecheck": "pnpm -r --if-present run typecheck"
  }
}
