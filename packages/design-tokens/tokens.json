        "800": "#065F46",
        "900": "#064E3B",
        "950": "#022C22"
      },
      "white": "#FFFFFF",
      "black": "#000000"
    },
    "font": {
      "sans": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', 'Courier New', monospace"
    },
    "text": {
      "xs": { "size": "0.75rem", "lineHeight": "1rem" },
      "sm": { "size": "0.875rem", "lineHeight": "1.25rem" },
      "base": { "size": "1rem", "lineHeight": "1.5rem" },
      "lg": { "size": "1.125rem", "lineHeight": "1.75rem" },
      "xl": { "size": "1.25rem", "lineHeight": "1.75rem" },
      "2xl": { "size": "1.5rem", "lineHeight": "2rem" },
      "3xl": { "size": "1.875rem", "lineHeight": "2.25rem" },
      "4xl": { "size": "2.25rem", "lineHeight": "2.5rem" }
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600"
    },
    "leading": {
      "tight": "1.25",
      "normal": "1.5"
    },
    "space": {
      "base": "0.25rem",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "6": "1.5rem",
      "8": "2rem",
      "12": "3rem",
      "16": "4rem"
    },
    "radius": {
      "sm": "0.25rem",
      "md": "0.5rem",
      "lg": "0.75rem",
      "xl": "1rem",
      "full": "9999px"
    },
    "shadow": {
      "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
      "md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
      "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)"
    },
    "duration": {
      "fast": "100ms",
      "base": "200ms",
      "slow": "300ms"
    },
    "ease": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0, 1)"
    },
    "animate": {
      "pulse": "pulse 1.5s ease-in-out infinite"
    }
  },
  "semantic": {
    "canvas": { "light": { "ref": "gray-50" }, "dark": { "ref": "gray-950" } },
    "surface": { "light": { "ref": "white" }, "dark": { "ref": "gray-900" } },
    "surface-raised": { "light": { "ref": "gray-100" }, "dark": { "ref": "gray-800" } },
    "fg": { "light": { "ref": "gray-900" }, "dark": { "ref": "gray-50" } },
    "fg-muted": { "light": { "ref": "gray-700" }, "dark": { "ref": "gray-400" } },
    "fg-subtle": { "light": { "ref": "gray-600" }, "dark": { "ref": "gray-450" } },
    "border": { "light": { "ref": "gray-200" }, "dark": { "ref": "gray-800" } },
    "border-strong": { "light": { "ref": "gray-500" }, "dark": { "ref": "gray-500" } },
    "brand": { "light": { "ref": "emerald-700" }, "dark": { "ref": "emerald-400" } },
    "brand-fg": { "light": { "ref": "white" }, "dark": { "ref": "black" } },
    "brand-subtle": { "light": { "ref": "emerald-50" }, "dark": { "ref": "emerald-950" } },
    "brand-subtle-fg": { "light": { "ref": "emerald-800" }, "dark": { "ref": "emerald-200" } },
    "primary": { "light": { "ref": "teal-700" }, "dark": { "ref": "teal-300" } },
    "primary-fg": { "light": { "ref": "white" }, "dark": { "ref": "gray-950" } },
    "success": { "light": { "ref": "green-700" }, "dark": { "ref": "green-400" } },
    "success-subtle": { "light": { "ref": "green-50" }, "dark": { "ref": "green-950" } },
    "success-subtle-fg": { "light": { "ref": "green-800" }, "dark": { "ref": "green-200" } },
    "warning": { "light": { "ref": "amber-700" }, "dark": { "ref": "amber-400" } },
    "warning-subtle": { "light": { "ref": "amber-50" }, "dark": { "ref": "amber-950" } },
    "warning-subtle-fg": { "light": { "ref": "amber-800" }, "dark": { "ref": "amber-200" } },
    "danger": { "light": { "ref": "red-700" }, "dark": { "ref": "red-400" } },
    "danger-subtle": { "light": { "ref": "red-50" }, "dark": { "ref": "red-950" } },
    "danger-subtle-fg": { "light": { "ref": "red-700" }, "dark": { "ref": "red-200" } },
    "info": { "light": { "ref": "blue-700" }, "dark": { "ref": "blue-400" } },
    "info-subtle": { "light": { "ref": "blue-50" }, "dark": { "ref": "blue-950" } },
    "info-subtle-fg": { "light": { "ref": "blue-700" }, "dark": { "ref": "blue-200" } },
    "focus": { "light": { "ref": "teal-700" }, "dark": { "ref": "teal-300" } },
    "overlay": {
      "light": { "raw": "rgb(28 25 23 / 0.6)" },
      "dark": { "raw": "rgb(12 10 9 / 0.7)" }
    }
  },
  "theme": {
    "font": ["sans", "mono"],
    "text": ["xs", "sm", "base", "lg", "xl", "2xl", "3xl", "4xl"],
    "weight": { "regular": "normal", "medium": "medium", "semibold": "semibold" },
    "leading": ["tight", "normal"],
    "radius": ["sm", "md", "lg", "xl", "full"],
    "shadow": ["sm", "md", "lg"],
    "ease": ["standard", "decelerate"],
    "animate": ["pulse"],
    "defaultTransitionDuration": "base"
  }
}
