# Disalin ke .env (dibaca docker compose; Laravel juga boleh pakai file ini).
# Nilai di bawah adalah placeholder LOKAL — TIDAK boleh dipakai di staging/produksi.

# --- Port host ---
API_PORT=8000
WEB_PORT=3000
MYSQL_PORT=3306
REDIS_PORT=6379

# --- MySQL 8 (service `mysql`) ---
MYSQL_DATABASE=trailgate
MYSQL_USER=trailgate
MYSQL_PASSWORD=local-dev-only
MYSQL_ROOT_PASSWORD=local-dev-only-root

# --- URL API untuk apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
