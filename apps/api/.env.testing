# Lingkungan tes (APP_ENV=testing). Hanya nilai uji, tanpa rahasia.
# APP_KEY sengaja kosong: kunci acak dibuat saat proses tes oleh bootstrap/phpunit-testing.php.
# Jangan pernah menaruh kunci di file ini (AGENTS.md #11).
APP_NAME=TrailGate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=array
BROADCAST_CONNECTION=null
MAIL_MAILER=array
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"
